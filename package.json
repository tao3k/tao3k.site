{
  "name": "tao3k.site",
  "version": "1.0.0",
  "private": true,
  "description": "Commercial runtime surface for tao3k and xiuxian-artisan-workshop.",
  "keywords": [
    "effect",
    "react-aria",
    "tanstack-start",
    "xiuxian"
  ],
  "homepage": "https://github.com/tao3k/tao3k.site#readme",
  "bugs": {
    "url": "https://github.com/tao3k/tao3k.site/issues"
  },
  "license": "UNLICENSED",
  "author": "tao3k",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/tao3k/tao3k.site.git"
  },
  "directories": {
    "doc": "docs"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "format": "oxfmt --write \"src/**/*.{ts,tsx}\" \"vite.config.ts\" \"package.json\" \"tsconfig.json\" \".oxfmtrc.json\" \"!src/routeTree.gen.ts\"",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx}\" \"vite.config.ts\" \"package.json\" \"tsconfig.json\" \".oxfmtrc.json\" \"!src/routeTree.gen.ts\"",
    "lint": "oxlint --react-plugin --jsx-a11y-plugin --import-plugin --tsconfig tsconfig.json src vite.config.ts",
    "start": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.50",
    "effect": "^3.21.2",
    "react": "^19.2.5",
    "react-aria-components": "^1.17.0",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "lightningcss": "^1.32.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  }
}
